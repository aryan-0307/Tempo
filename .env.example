# ==============================================================================
# Tempo Environment Configuration Template (PostgreSQL Edition)
# Copy this file to .env and configure your PostgreSQL / Neon credentials.
# NEVER commit the actual .env file with real credentials to source control.
# ==============================================================================

# Application Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Express Server Port (Render sets this dynamically via process.env.PORT)
PORT=3000

# ==============================================================================
# PostgreSQL Connection Settings (Neon PostgreSQL / Render / Local)
# ==============================================================================

# Option A: Cloud Database URL (Recommended for Neon PostgreSQL and Render)
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
# DATABASE_URL=postgresql://username:password@ep-sample-123456.us-east-2.aws.neon.tech/tempo_db?sslmode=require

# Option B: Discrete Parameters (for local PostgreSQL instance)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=tempo_db
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

# Connection Pool Configuration
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=10000

# ==============================================================================
# Legacy MySQL Settings (Preserved for safe export/migration procedure)
# ==============================================================================
MYSQL_DB_HOST=127.0.0.1
MYSQL_DB_PORT=3306
MYSQL_DB_NAME=tempo_db
MYSQL_DB_USER=root
MYSQL_DB_PASSWORD=

# ==============================================================================
# Authentication & Security Settings (Phase 5)
# ==============================================================================
JWT_SECRET=replace_with_a_secure_random_jwt_secret_in_production
JWT_EXPIRES_IN=7d
