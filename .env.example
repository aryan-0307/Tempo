# ==============================================================================
# Tempo Environment Configuration Template
# Copy this file to .env and fill in your local MySQL credentials.
# NEVER commit the actual .env file with real credentials to source control.
# ==============================================================================

# Application Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Express Server Port
PORT=3000

# ==============================================================================
# MySQL Database Connection Settings
# ==============================================================================

# Database Host (usually localhost or 127.0.0.1)
DB_HOST=127.0.0.1

# Database Port (default MySQL port is 3306)
DB_PORT=3306

# Database Name (run 'CREATE DATABASE tempo_db;' in MySQL)
DB_NAME=tempo_db

# Database User
DB_USER=root

# Database Password (leave blank if your local dev instance has no password)
DB_PASSWORD=

# Connection Pool Configuration
DB_CONNECTION_LIMIT=10
DB_WAIT_FOR_CONNECTIONS=true
DB_QUEUE_LIMIT=0
DB_CONNECT_TIMEOUT=10000

# Timezone: Force UTC ('Z' or '+00:00') for consistent DATETIME serialization
DB_TIMEZONE=Z

# ==============================================================================
# Authentication & Security Settings (Phase 5)
# ==============================================================================
JWT_SECRET=replace_with_a_secure_random_jwt_secret_in_production
JWT_EXPIRES_IN=7d

