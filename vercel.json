{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/my-tasks",
      "destination": "/index.html"
    },
    {
      "source": "/upcoming",
      "destination": "/index.html"
    },
    {
      "source": "/completed",
      "destination": "/index.html"
    },
    {
      "source": "/settings",
      "destination": "/index.html"
    }
  ]
}
